# ---- AI (chat + forecast ka explanation) : FREE option ----
GEMINI_API_KEY=yahan-apni-gemini-key-paste-kijiye
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- ASLI mandi bhaav (data.gov.in / Agmarknet) : FREE key ----
# https://data.gov.in par register/login karke My Account se API key banaiye
DATA_GOV_API_KEY=yahan-data-gov-in-ki-key-paste-kijiye
# Kis state ka data chahiye (default: Madhya Pradesh)
# MANDI_STATE=Madhya Pradesh
# Optional / experimental: purani dates ka data laane ki koshish (agar API deti hai). Jaise 7
# BACKFILL_DAYS=0

# ---- Admin page (registered users dekhne ke liye): http://localhost:3000/admin ----
# username: admin   password: neeche jo likhenge
ADMIN_PASSWORD=koi-mazboot-password-likhiye

# ---- PAID option (Claude) - sirf agar credit ho ----
# ANTHROPIC_API_KEY=sk-ant-...
